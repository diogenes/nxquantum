# Goldens for examples/livebook/researcher_reproducibility.livemd.
#
# The fingerprint is exact. Measured on OTP 29.1.2 / Elixir 1.20.4. The CI floor job also runs
# this test on OTP 28.1. OTP does not promise that term_to_binary(_, [:deterministic]) stays
# stable across majors. If a future OTP changes it, re-derive the value here and in the notebook
# prose, and say so in the CHANGELOG.
# Counts are exact. Floats use the 1.0e-6 absolute tolerance (f32 results, docs/backend-support.md).
%{
  "fingerprint_properties" => %{
    format_ok: true,
    key_order_independent: true,
    value_sensitive: true,
    list_order_sensitive: true
  },
  "fingerprint_golden" => "v1:6a65205f6292c5336526e8dcb7fed7fd3f54edfa3910729e25c5b24a0a9c4c00",
  "seeded_replay" => %{
    replay_equal: true,
    counts_seed_2026: %{"0" => 1325, "1" => 723},
    counts_seed_2027: %{"0" => 1406, "1" => 642},
    different_seed_differs: true
  },
  # Analytic: cos(angle), compared within 1.0e-6 (the estimator returns f32).
  "closed_form" => %{
    all_within_tolerance: true,
    values: Enum.map([0.0, 0.4, 0.8, 1.2, 2.0, 3.0], &:math.cos/1)
  },
  # Analytic: |(1406 - 642) / 2048 - cos(1.2)| = |0.373046875 - cos(1.2)|, where 0.373046875 is exact
  # for the seed-2027 counts.
  "portability_delta" => %{
    expectation_delta_abs: abs(0.373046875 - :math.cos(1.2)),
    latency_delta_ms: 0.0,
    sample_kl_divergence: 0.0
  }
}
