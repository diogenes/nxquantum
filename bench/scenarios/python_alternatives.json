  "families": {
    "real": {
      "structure": "H on every wire; then for layer l in 0..L-1: RY(w, angle[l*n+w]) for w in 0..n-1, then CNOT(i,i+1) for i = l mod 2, l mod 2 + 2, ... while i+1 < n",
      "angles_per_set": "L*n"
    },
    "complex": {
      "structure": "for layer l in 0..L-1: RX(w, angle[l*2n+w]) for w in 0..n-1, RZ(w, angle[l*2n+n+w]) for w in 0..n-1, then CNOT(i,i+1) for i = l mod 2, l mod 2 + 2, ... while i+1 < n; no H layer",
      "angles_per_set": "2*L*n"
    }
  },
  "prefix_parity": {
    "real": "RY(w, theta_w) on every wire, then CNOT(j,j+1) for j = 0..n-2 in ascending order; <Z_k> = prod_{j<=k} cos(theta_j)",
    "complex": "RX(w, theta_w) then RZ(w, phi_w) on every wire, then the same CNOT chain; <Z_k> = prod_{j<=k} cos(theta_j)"
  },
