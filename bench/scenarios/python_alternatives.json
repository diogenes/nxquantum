    "rng": "numpy.random.Generator(PCG64(seed))",
    "seed_formula": "20261026 + 100*family_index + qubits",
    "prefix_parity_angles": "theta_w=(w+1)/64 (k=16(w+1)); complex phi_w=2theta_w (k=32(w+1)); deterministic",
